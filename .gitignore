# IDA 数据库（约 219MB）体积过大不入库，需要时从 platform\gamemd 复制
/ida_work/*.idb
/ida_work/*.i64
/ida_work/*.nam
/ida_work/*.til
# 强杀 IDA 后残留的未打包库，以及临时改名存放它们的目录（用完整套即删，勿长期堆积）
/ida_work/*.id0
/ida_work/*.id1
/ida_work/_stale_ida*/

# Python 工具（tools/gen_hook_conflict.py 等）的字节码缓存
__pycache__/
*.pyc

# AI 助手的工作记忆（私有工作状态，不入库；确实要提交时用 git add -f）
/.workbuddy/

# 构建日志（临时产物，不是分析证据；分析证据是 ida_work/ida_*.log 与 *_probe.txt）
/ida_work/build_*.log
/out_build*.log
# 仓库根目录下的零散构建日志（例如手工跑 msbuild 时重定向出来的 build_fix*.log）
/build_*.log
